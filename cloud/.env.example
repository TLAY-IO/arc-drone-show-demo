## Copy this file to .env and fill in your values.
## NEVER commit .env to git (see .gitignore).

# --- MQTT ---
# The broker requires authentication (see cloud/mosquitto/mosquitto.conf).
# Run cloud/mosquitto/gen-passwd.sh once, then set matching URLs here.
# Roles: web (page + /api/mint), worker (settle + burn-intent), device
# (put device credentials in the firmware broker URI:
#  mqtt://device:<pass>@<host>:1883 — esp-mqtt parses user:pass, no code change).
# Leave these EMPTY. gen-passwd.sh prints the two lines to paste here.
# compose refuses to start while they are unset, which is deliberate: a
# placeholder value would satisfy the guard and fail later at MQTT auth.
MQTT_URL_WEB=
MQTT_URL_WORKER=

# LAN address of THIS host, so the eCandle board can reach the broker. Leave
# unset to keep the broker on loopback (cloud-only testing, no seller board).
# Use the same address in the firmware broker URI (idf.py menuconfig).
MQTT_BIND_IP=

# --- HashAnchor ---
# settle endpoint. The /v1/x402/settle path is PUBLIC (no API key needed).
# Devices select chain via paymentRequirements.network in each request;
# demo devices sign Arc Testnet payloads, so settle naturally routes there.
# Base URL only — the client appends /v1/x402/settle itself. Putting the full
# endpoint path here makes every settle POST to /v1/x402/settle/v1/x402/settle,
# which answers 401 and looks like a missing API key rather than a bad URL.
HASHANCHOR_SETTLE_URL=https://hashanchor.xid.network

# Optional: only needed if you also use HashAnchor's /v1/hashes anchoring
# (not used by the default settle path). Get one at https://hashanchor.xid.network
HASHANCHOR_API_KEY=

# =====================================================================
#  CHAIN PROFILE — one set of generic variables; the values select the
#  network. Defaults compiled into the code are the Arc TESTNET set, the
#  path this repo has actually run end-to-end. To target Arc Mainnet,
#  uncomment the mainnet block and fill it from Circle's official
#  contract-address reference.
# =====================================================================

# --- Arc Testnet — these equal the code defaults, so you may leave them
#     all unset to run on testnet ---
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_GATEWAY_DOMAIN_ID=26
ARC_GATEWAY_CONTRACT=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
ARC_MINTER_CONTRACT=0x0022222ABE238Cc2C7Bb1f21003F0a260052475B
ARC_USDC_CONTRACT=0x3600000000000000000000000000000000000000
# EIP-712 GatewayWallet domain (testnet — proven by live settlement)
ARC_EIP712_DOMAIN_NAME=GatewayWallet
ARC_EIP712_DOMAIN_VERSION=1
ARC_EXPLORER=https://testnet.arcscan.app
CIRCLE_TRANSFER_URL=https://gateway-api-testnet.circle.com/v1/transfer

# --- Arc Mainnet (the production chain) — fill every value from Circle's
#     official contract-address reference. Mainnet contract addresses differ
#     from testnet; a wrong address or domain field makes every signature
#     fail to recover, so use the published values. ---
# ARC_RPC_URL=<your Arc mainnet RPC endpoint>
# ARC_CHAIN_ID=5042
# ARC_GATEWAY_DOMAIN_ID=<from Circle reference>
# ARC_GATEWAY_CONTRACT=<from Circle reference — the EIP-712 verifyingContract>
# ARC_MINTER_CONTRACT=<from Circle reference>
# ARC_USDC_CONTRACT=<from Circle reference>
# ARC_EIP712_DOMAIN_NAME=<from Circle reference>
# ARC_EIP712_DOMAIN_VERSION=<from Circle reference>
# ARC_EXPLORER=https://explorer.arc.io
# CIRCLE_TRANSFER_URL=https://gateway-api.circle.com/v1/transfer

# Web page explorer links (NEXT_PUBLIC_ = inlined at Next.js build time)
# NEXT_PUBLIC_ARC_EXPLORER=https://testnet.arcscan.app/tx/

# --- Demo visualization ---
# HTTP Basic Auth for /demo, /api/mint and /api/stream (cloud/web/proxy.ts).
# Leave empty to disable — acceptable on a private LAN, not internet-facing.
DRONE_DEMO_AUTH_USER=
DRONE_DEMO_AUTH_PASS=

# REQUIRED for the "Mint to Arc" flow: YOUR seller device's EOA (the eCandle
# prints it on boot) and its device id. There is intentionally no default —
# the depositor is the wallet real mints draw from. Leave empty and the demo
# page still runs, with minting disabled. NEXT_PUBLIC_ vars are inlined at
# Next.js BUILD time: set them before `docker compose build` / `npm run build`.
NEXT_PUBLIC_DEMO_SELLER_EOA=
NEXT_PUBLIC_DEMO_DEVICE_ID=

# --- Burn-intent worker (Mint to Arc) ---
# The worker is an optional compose service (docker compose --profile mint up).
# Host path of the operator wallet key (gas-only wallet that submits
# gatewayMint). Generate: node burn-intent-worker/scripts/gen-operator-wallet.js
OPERATOR_KEY_FILE=~/.ecandle-secrets/operator.key

# OPTIONAL per-mint hard cap in µUSDC. Empty/unset = unlimited (default).
# When set, one "Mint to Arc" click covers a FIFO subset of unminted Circle
# UUIDs summing to ≤ this cap; the remainder stays unminted for the next
# click. If set, must be ≥ MIN_MINT_VALUE_MICRO (default 10000).
#MINT_MAX_VALUE_MICRO=15000

# --- Settle worker config ---
# How many slice proofs to batch before forwarding to HashAnchor
SETTLE_BATCH_SIZE=6
# Max batch age in milliseconds before forwarding partial batch
SETTLE_BATCH_MAX_AGE_MS=30000
